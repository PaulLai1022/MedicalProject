# LLM configuration
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_LOG_ENABLED=true
# Set to `false` for endpoints that do NOT support OpenAI-style json_schema
# strict mode (e.g. DeepSeek). When strict mode is not supported, leaving this
# on costs one wasted 400 round-trip per LLM call before the client falls back
# to json_object. Set to `true` only on endpoints (e.g. OpenAI, Azure OpenAI
# newer models) that advertise json_schema strict support.
LLM_USE_STRICT_SCHEMA=false

# JWT
JWT_SECRET=change-me-to-a-random-32-byte-string
JWT_EXPIRE_MINUTES=1440

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Backend port (pass to uvicorn at launch)
# uvicorn app.main:app --reload --port 8200

# Database
DATABASE_URL=sqlite:///./data/app.db

# Logging
LOG_LEVEL=INFO

# Seed data
SEED_DEMO=true
