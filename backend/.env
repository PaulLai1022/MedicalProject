# LLM configuration
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-36a1f96cf1d74a338e63a8437ae3e14c
LLM_MODEL=deepseek-v4-flash
LLM_LOG_ENABLED=true
# DeepSeek does not support json_schema strict mode; disable to avoid a wasted
# 400 round-trip per LLM call. Set to `true` only on endpoints (e.g. OpenAI)
# that advertise `response_format: json_schema` strict support.
LLM_USE_STRICT_SCHEMA=false

# JWT
JWT_SECRET=change-me-to-a-random-32-byte-string
JWT_EXPIRE_MINUTES=1440

# Frontend origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=sqlite:///./data/app.db

# Logging
LOG_LEVEL=INFO

# Seed data
SEED_DEMO=true
